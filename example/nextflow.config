plugins {
    id 'nf-gadi-usage-reports@1.0.0'
}

// Your Gadi project code, for example ab12. Required on Gadi.
params.project = null

// The storage that the jobs can use, as PBS expects it.
// Add /g/data if you need it, for example "scratch/ab12+gdata/ab12".
params.storage = "scratch/${params.project}"

process {
    executor = 'pbspro'
    queue = 'normal'
    // Nextflow ignores the cpus and memory directives when clusterOptions
    // contains an -l option, and Gadi needs -l storage. So the CPUs and
    // memory of each task are requested here. Nextflow adds the walltime.
    clusterOptions = {
        def mem = task.memory ? ",mem=${task.memory.toMega()}mb" : ""
        "-P ${params.project} -l ncpus=${task.cpus}${mem},storage=${params.storage}"
    }

    // The resources for each label, as in nf-core pipelines. The values are
    // small so that the example jobs are cheap. The report shows these values.
    withLabel: process_single {
        cpus   = 1
        memory = 1.GB
        time   = 5.min
    }
    withLabel: process_low {
        cpus   = 2
        memory = 2.GB
        time   = 10.min
    }
    withLabel: process_medium {
        cpus   = 4
        memory = 4.GB
        time   = 10.min
    }
}

executor {
    queueSize = 10
}

// Optional: copy both reports to a folder when the pipeline completes
// gadi {
//     publishTo = "/scratch/${params.project}/usage-reports/"
// }

profiles {
    // Run every task on the current machine, to check the pipeline without Gadi.
    // The tasks are then not Gadi jobs, so the report shows their names only.
    local {
        process.executor = 'local'
    }
}
